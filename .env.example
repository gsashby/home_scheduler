# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by scheduled jobs / admin routes — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (sign-in) + Google Calendar API (two-way sync)
# Create in Google Cloud Console; enable the Calendar API; add as an OAuth
# provider in Supabase Auth with the Calendar scopes below.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# https://www.googleapis.com/auth/calendar

# Web Push (VAPID) — daily brief / deadline alerts / parent nudges.
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Base URL of the deployed app (used in server-generated links/notifications)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
